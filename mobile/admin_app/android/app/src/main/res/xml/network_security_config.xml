<?xml version="1.0" encoding="utf-8"?>
<!--
  The backend currently runs on a plain-HTTP IP address (no domain/TLS cert
  yet). Android blocks cleartext traffic by default from API 28+, so this
  explicitly allows it for that one host only.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">195.22.157.38</domain>
    </domain-config>
</network-security-config>
