# Shared config for the PHP chatbot app - used by chat.blake-uk.com and by
# blakegroup.uk's admin./chat. subdomains, which serve the same backend
# under a different hostname rather than duplicating this block three times.
(chat_app) {
    root * /var/www/chat/public
    php_fastcgi unix//run/php/php8.2-fpm.sock

    # Block direct access to sensitive paths
    @blocked path /config/* /data/* /uploads/* /logs/* /scripts/*
    respond @blocked 403

    file_server

    header {
        X-Content-Type-Options nosniff
        Referrer-Policy strict-origin-when-cross-origin
        Permissions-Policy "geolocation=(), microphone=(), camera=()"
        X-Frame-Options SAMEORIGIN
    }
}

chat.blake-uk.com {
    import chat_app
}

# blakegroup.uk: standalone intro site at the apex, not connected to
# blake-uk.com in any way (deliberately - nothing here should redirect
# there). /admin and /api paths route to the same backend/database as
# chat.blake-uk.com rather than a second copy of it - this is in addition
# to (not instead of) the admin./chat. subdomains below, since blakegroup.uk/admin
# is what actually got tested and it needs to work as a path too, not just
# as a subdomain.

blakegroup.uk, www.blakegroup.uk {
    @app path /admin /admin/* /api/* /chat /chat/*
    handle @app {
        root * /var/www/chat/public
        php_fastcgi unix//run/php/php8.2-fpm.sock
        file_server
    }

    handle {
        root * /var/www/blakegroup/public
        file_server
    }

    header {
        X-Content-Type-Options nosniff
        Referrer-Policy strict-origin-when-cross-origin
        Permissions-Policy "geolocation=(), microphone=(), camera=()"
        X-Frame-Options SAMEORIGIN
    }
}

admin.blakegroup.uk {
    redir / /admin/

    @robots path /robots.txt
    handle @robots {
        root * /var/www/blakegroup/robots-admin
        file_server
    }

    handle {
        import chat_app
    }
}

# No content at /chat yet - this just makes the routing exist ahead of it,
# so dropping an index.html at /var/www/chat/public/chat/ later is all
# that's needed. 404s until then.
chat.blakegroup.uk {
    redir / /chat/

    @robots path /robots.txt
    handle @robots {
        root * /var/www/blakegroup/robots-chat
        file_server
    }

    handle {
        import chat_app
    }
}
