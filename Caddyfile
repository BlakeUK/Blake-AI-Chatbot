# Shared config for the PHP chatbot app - served from blakegroup.uk's
# admin./chat. subdomains and from /admin, /api paths on the apex, which
# all route to the same backend under different hostnames/paths rather
# than duplicating this block. chat.blake-uk.com is NOT a domain this app
# is actually reachable on - removed after confirming that directly, not
# assumed; don't re-add a block for it without checking DNS again first.
(chat_app) {
    root * /var/www/chat/public
    php_fastcgi unix//run/php/php8.2-fpm.sock

    # Block direct access to sensitive paths
    @blocked path /config/* /data/* /uploads/* /logs/* /scripts/*
    respond @blocked 403

    file_server

    header {
        X-Content-Type-Options nosniff
        Referrer-Policy strict-origin-when-cross-origin
        Permissions-Policy "geolocation=(), microphone=(), camera=()"
        X-Frame-Options SAMEORIGIN
    }
}

# blakegroup.uk: standalone intro site at the apex, not connected to
# blake-uk.com in any way (deliberately - nothing here should redirect
# there). /admin and /api paths route to the same backend/database as
# the admin./chat. subdomains below rather than a second copy of it - this
# is in addition to (not instead of) those subdomains, since blakegroup.uk/admin
# is what actually got tested and it needs to work as a path too, not just
# as a subdomain.

blakegroup.uk, www.blakegroup.uk {
    # File-existence match rather than an enumerated path list: the previous
    # version (@intro path / /index.html /support.js ... /_ds/*) required
    # every new static asset to be added here by hand, and silently fell
    # through to the chat app's webroot for anything missed - exactly what
    # happened to generate_a_video_of_greens_bl.mp4 (deployed correctly to
    # /var/www/blakegroup/public, but never served from there, because it
    # wasn't in this list). Checking actual file existence means any current
    # or future file in that directory is served correctly with no Caddyfile
    # change needed, and anything genuinely missing still falls through to
    # the app (or 404s) exactly as before.
    @static_exists {
        file {
            root /var/www/blakegroup/public
            try_files {path} {path}index.html
        }
    }
    handle @static_exists {
        root * /var/www/blakegroup/public
        file_server
    }

    handle {
        root * /var/www/chat/public
        php_fastcgi unix//run/php/php8.2-fpm.sock
        file_server
    }

    header {
        X-Content-Type-Options nosniff
        Referrer-Policy strict-origin-when-cross-origin
        Permissions-Policy "geolocation=(), microphone=(), camera=()"
        X-Frame-Options SAMEORIGIN
    }
}

admin.blakegroup.uk {
    redir / /admin/

    @robots path /robots.txt
    handle @robots {
        root * /var/www/blakegroup/robots-admin
        file_server
    }

    handle {
        import chat_app
    }
}

# No content at /chat yet - this just makes the routing exist ahead of it,
# so dropping an index.html at /var/www/chat/public/chat/ later is all
# that's needed. 404s until then.
chat.blakegroup.uk {
    redir / /chat/

    @robots path /robots.txt
    handle @robots {
        root * /var/www/blakegroup/robots-chat
        file_server
    }

    handle {
        import chat_app
    }
}
