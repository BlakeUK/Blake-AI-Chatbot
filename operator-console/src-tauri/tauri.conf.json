{
  "build": {
    "distDir": "../dist",
    "devPath": "../dist",
    "beforeDevCommand": "",
    "beforeBuildCommand": "",
    "withGlobalTauri": true
  },
  "package": {
    "productName": "Blake UK Operator Console",
    "version": "0.14.0"
  },
  "tauri": {
    "bundle": {
      "active": true,
      "identifier": "uk.blake.operatorconsole",
      "icon": [
        "icons/32x32.png",
        "icons/128x128.png",
        "icons/128x128@2x.png",
        "icons/icon.ico"
      ],
      "targets": "all",
      "resources": [],
      "shortDescription": "Ticket notifications and department routing for Blake UK support staff",
      "longDescription": "Desktop console for Blake UK support staff: get notified when the chatbot needs a human, hand tickets off between sales/technical/accounts and specific colleagues, and review the conversation before replying."
    },
    "security": {
      "csp": null
    },
    "allowlist": {
      "all": false,
      "notification": { "all": true },
      "shell": { "open": true },
      "app": { "all": true }
    },
    "systemTray": {
      "iconPath": "icons/32x32.png",
      "iconAsTemplate": false
    },
    "windows": [
      {
        "label": "main",
        "title": "Blake UK Operator Console",
        "width": 1300,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "center": true
      }
    ]
  }
}
